# FloodGuard environment template
# Copy only the variables needed by the component you are running.
# Never commit a real .env file, access key, token, or other secret.

# -------------------------
# Frontend (Vite)
# -------------------------
# Base URL of the backend API. Update to match your local or deployed API.
# VITE_ variables are bundled into frontend code; never put secrets here.
VITE_API_BASE_URL=http://localhost:3000

# -------------------------
# Backend / AWS (optional until the corresponding integration is implemented)
# -------------------------
# Set these only if the backend code uses them.
AWS_REGION=ap-south-1

# Private S3 bucket for citizen incident-report photos (backend only).
# The Lambda execution role needs scoped s3:PutObject, s3:HeadObject,
# s3:GetObject (for signature validation and authorized viewing), plus DynamoDB
# access to REPORTS_TABLE_NAME. Keep this bucket private.
# PHOTO_BUCKET_NAME=

# DynamoDB table for incident reports/risk records, if persistence is implemented.
# DYNAMODB_TABLE_NAME=

# -------------------------
# Notes
# -------------------------
# - Prefer an IAM execution role for deployed Lambda functions.
# - Do not add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY to committed files.
# - Local AWS credentials, if needed, should be configured securely outside
#   this file (for example, through your AWS CLI profile).
# - Remove or rename any variable that the final implementation does not use.

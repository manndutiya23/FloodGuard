# FloodGuard frontend configuration (Vite).
# VITE_ variables are bundled into browser code: never put secrets or AWS credentials here.

# Base URL the browser calls. "/api" uses the Vite dev proxy below.
# For a deployed API Gateway stage, set the full URL instead (CORS must be enabled there).
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests (local FastAPI backend by default).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# true = use bundled simulated mock data; false = call the API.
VITE_USE_MOCKS=true
